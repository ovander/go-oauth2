# Server Configuration
PORT=8080
ADMIN_PORT=
ENV=development
PHX_HOST=localhost
# ADMIN_CONSOLE_CLIENT_ID: client_id of the first-party admin console (a public,
# PKCE client). When set, /oauth/token delivers that client's refresh token as
# an HttpOnly; Secure (prod); SameSite=Strict cookie (path /oauth/token) instead
# of in the JSON body — XSS-safe silent refresh — and logout clears it. Empty
# (default) disables the cookie channel. Tier-0 admin session hardening.
ADMIN_CONSOLE_CLIENT_ID=

# Logging (RFC-008)
# LOG_LEVEL: trace|debug|info|warn|error (default info). Set debug to enable the
#   OAuth flow-tracing without restarting the format.
LOG_LEVEL=info
# LOG_FORMAT: json|text. Explicit value wins; if unset the format derives from ENV
#   (production/unset => json for ELK/Loki/Datadog ingestion; development/test/local
#   => human-readable text).
LOG_FORMAT=

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oauth2_dev?sslmode=disable
DB_POOL_SIZE=10
DB_TIMEOUT_SECONDS=30

# OAuth/JWT
OAUTH_ISSUER=http://localhost:8080
JWT_SECRET=your-jwt-secret-key-here

# Token TTLs (in seconds)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
EMAIL_TOKEN_TTL=86400
RESET_TOKEN_TTL=3600
INVITE_TOKEN_TTL=86400
# Cache-Control max-age (seconds) for the JWKS endpoint so resource servers
# cache the key set. Keep modest so rotated keys are picked up promptly; 0
# disables caching (no-store). Default 300.
JWKS_CACHE_MAX_AGE_SECONDS=300

# CORS — comma-separated list of allowed origins (e.g. "https://app.example.com,https://admin.example.com")
# Leave empty to allow all origins without credentials (not recommended for production)
ALLOWED_ORIGINS=https://app.example.com

# Security
SECRET_KEY_BASE=your-secret-key-base-at-least-32-characters-long
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=900
# Admin MFA enrollment policy: off (default) | observe (allow but audit admins
# without MFA) | enforce (deny admin-portal login until the admin enrolls MFA).
ADMIN_MFA_POLICY=off
# OAuth 2.0 Token Exchange (RFC 8693): off (default — grant unsupported) |
# shadow (validate + audit attempts but never issue) | enforce (issue exchanged
# tokens). Per-client allow_token_exchange / allow_impersonation gate which
# clients may use it; exchanged tokens are downscoped, audience-bound, and short
# lived (access-token TTL).
TOKEN_EXCHANGE_MODE=off
# Impersonation time-box (EPIC-17): lifetime in seconds of an access token minted
# via impersonation (the actor-absent token-exchange case). Impersonation is
# sensitive, so its tokens auto-expire quickly; the value is capped at
# ACCESS_TOKEN_TTL at issuance and never affects delegation. Default 300 (5 min).
IMPERSONATION_TOKEN_TTL=300
# Impersonation step-up (EPIC-17): require the impersonated subject to have
# authenticated recently. off (default — no check) | observe (audit a would-be
# denial but still issue) | enforce (deny when the subject's auth_time is older
# than the window). A subject token without auth_time can't prove freshness and
# is treated as stale. Delegation is unaffected.
IMPERSONATION_STEPUP_MODE=off
# Freshness window in seconds for the step-up check (0 disables it). Default 900.
IMPERSONATION_MAX_AUTH_AGE=900
# Delegation step-up (EPIC-17): require the human actor in a delegation
# token-exchange to have authenticated with MFA. off (default — no check) |
# observe (audit a would-be denial but still issue) | enforce (deny when the
# actor token's amr does not contain "mfa"). An actor token minted without amr
# (e.g. from a non-interactive flow) cannot satisfy enforce.
DELEGATION_STEPUP_MODE=off
# Refresh-token reuse detection (OAuth 2.0 Security BCP / RFC 9700 §4.14.2):
# how to react when an already-rotated single-use refresh token is presented
# again (a token-theft signal). off (default — reject the reused token only,
# unchanged) | observe (also audit the reuse) | enforce (also revoke the user's
# token family so neither the attacker's nor the victim's tokens survive).
REFRESH_REUSE_MODE=off
# Audience binding (RFC-001 / EPIC-7): how an access token's `aud` is built.
# off (default — aud is the client_id, unchanged) | dual (the client's registered
# audiences are added alongside the client_id, so audience-aware resource servers
# can verify their resource id while client_id verifiers keep working). Register a
# client's audiences via the admin API. Canonical-only enforcement is a later step.
AUDIENCE_MODE=off
# DPoP (RFC 9449) sender-constraint at the token endpoint: off (default) |
# observe (verify proofs, log telemetry, bind tokens when a valid proof is sent,
# never reject) | enforce (also reject a present-but-invalid proof with
# 400 invalid_dpop_proof; a request with no proof still proceeds).
DPOP_MODE=off

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=60000
RATE_LIMIT_SIGNUP=3
RATE_LIMIT_SIGNUP_WINDOW=3600000
RATE_LIMIT_MAX_ENTRIES=10000

# SMTP (optional for development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
FROM_EMAIL=no-reply@example.com

# Keys path (for RSA keys)
KEYS_PATH=keys

# Signing key rotation (RFC-002 / EPIC-3)
# KEY_ROTATION_INTERVAL_SECONDS: how often to rotate the signing key.
#   0 (default) = disabled (rotate manually only).
#   Set <= REFRESH_TOKEN_TTL so a compromised key cannot outlive the next rotation.
KEY_ROTATION_INTERVAL_SECONDS=0
# KEY_RETENTION_SECONDS: how long a retired key is kept for verifying outstanding
#   tokens before it is pruned from the ring/JWKS.
#   0 (default) = derive from REFRESH_TOKEN_TTL (so retired keys outlive all tokens).
KEY_RETENTION_SECONDS=0

# Audit-row integrity scan (RFC-007 / EPIC-5)
# AUDIT_INTEGRITY_SCAN_INTERVAL_SECONDS: how often to verify stored audit rows'
#   HMACs and alert on tampering. 0 (default) = disabled.
AUDIT_INTEGRITY_SCAN_INTERVAL_SECONDS=0
# AUDIT_INTEGRITY_SCAN_LOOKBACK_SECONDS: trailing window each scan verifies (default 24h).
AUDIT_INTEGRITY_SCAN_LOOKBACK_SECONDS=86400
# USED_TOKEN_CLEANUP_INTERVAL_SECONDS: how often to prune expired rows from the
#   used_tokens table (single-use refresh JTIs + the per-token revocation
#   blacklist) so it doesn't grow without bound. Default 3600 (1h); 0 disables it.
USED_TOKEN_CLEANUP_INTERVAL_SECONDS=3600
