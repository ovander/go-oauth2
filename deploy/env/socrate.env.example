# /etc/socrate/socrate.env — Socrate backend (production).
# chmod 0640, owner root:socrate. See ../../.env.example for the FULL list of
# tunables; this template covers the essentials for the single-VPS, Caddy-fronted
# topology. Paths match the authoritative umbrella runbook (oauth2-monitoring).

ENV=production

# Dual-port: public OAuth on 8080, admin API on 8081 bound to loopback.
PORT=8080
ADMIN_PORT=8081
ADMIN_BIND_HOST=127.0.0.1

# Public issuer (must equal the OAuth subdomain served by Caddy).
OAUTH_ISSUER=https://socrate.vandermoten.eu

# Local Postgres.
DATABASE_URL=postgres://socrate:CHANGE_ME@127.0.0.1:5432/socrate?sslmode=disable

# >=32-byte random secret (openssl rand -hex 32). REQUIRED in production.
SECRET_KEY_BASE=CHANGE_ME_32_BYTES_MIN

# RSA signing-key directory. REQUIRED to be an ABSOLUTE path in production
# (the server refuses to start otherwise). Must be writable by the socrate user
# for key rotation, and must match ReadWritePaths in socrate.service.
KEYS_PATH=/var/lib/socrate/keys

# Browser origins allowed to call the APIs (the two consoles).
ALLOWED_ORIGINS=https://monitoring.vandermoten.eu,https://admin.vandermoten.eu

# Peers whose X-Forwarded-For is trusted for the client IP (rate limits, IP
# blocks, auto-defense, audit logs). Caddy and the consoles' BFFs connect from
# loopback, so this is the default; list every reverse-proxy address here and
# nothing else. Set to "none" only if Socrate is exposed directly (no proxy).
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Apply schema changes deliberately, not on every boot (set true once, then back).
AUTO_MIGRATE=false

# Tier-0 step-up freshness window (seconds) for destructive admin actions.
ADMIN_ELEVATION_MAX_AGE=300

# ---------------------------------------------------------------------------
# Opt-in controls. Each ships off and is turned on deliberately, one at a time,
# after reading its description in ../../.env.example. Uncomment to change.
# ---------------------------------------------------------------------------

# Hosted page where application users turn two-factor authentication on or off
# (https://<issuer>/account/security). off | on.
# ACCOUNT_SECURITY_PAGE=off

# Access-token aud: off (client_id only) | dual (client_id first, then the
# client's registered audiences).
# AUDIENCE_MODE=off

# Per-client allowed_scopes: off | observe | enforce.
# SCOPE_POLICY_MODE=off

# Prefix of the custom claims projected by a client's claim mappings.
# CLAIMS_NAMESPACE=https://socrate/

# Policy decision point on the admin API: off | shadow | enforce. Run shadow for
# a release before enforcing.
# POLICY_MODE=off

# Admin MFA enrolment at sign-in: off | observe | enforce. Enrol every admin
# before enforce.
# ADMIN_MFA_POLICY=off

# Operator consoles' client_ids (comma-separated). Required before either of
# the two enforce modes below; Socrate refuses to start without it.
# OPERATOR_CONSOLE_CLIENT_IDS=

# May an admin sign in to a non-console application: off | observe | enforce.
# ADMIN_APP_SIGNIN_POLICY=off

# Which tokens the admin API accepts: off | observe | enforce (console tokens
# and Socrate's own admin-portal tokens only).
# ADMIN_API_AUDIENCE_MODE=off

# Security audit writes: sync (in the request) | async (batched background
# writer; rows still queued at a hard kill are lost, a SIGTERM drains them).
# AUDIT_WRITE_MODE=sync
