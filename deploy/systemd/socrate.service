[Unit]
Description=Socrate OAuth 2.1 / OIDC server (public OAuth :8080, admin API :8081 loopback)
Documentation=https://github.com/ovander/go-oauth2
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=socrate
Group=socrate
WorkingDirectory=/var/lib/socrate
EnvironmentFile=/etc/socrate/socrate.env
# Canonical install path (matches the umbrella push.sh / install-remote.sh in the
# oauth2-monitoring deploy kit, which is the authoritative full-stack runbook).
ExecStart=/usr/local/bin/socrate
Restart=on-failure
RestartSec=5

# ── Hardening (Tier-0 control plane) ─────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# RSA signing keys (KEYS_PATH) are rotated at runtime, so the key directory must
# be writable; everything else on the filesystem stays read-only under
# ProtectSystem=strict. Keep KEYS_PATH in socrate.env pointed here.
ReadWritePaths=/var/lib/socrate/keys

[Install]
WantedBy=multi-user.target
